# Copy to .env.vercel and fill in, then run the deploy script.
# .env.vercel is gitignored by the existing .env* rule. Do not commit it.
#
# Everything here comes from your Supabase project dashboard.

# --- Database -------------------------------------------------------------
# Project Settings → Database → Connection string → "Session pooler".
#
# URL-ENCODE THE PASSWORD. `?` becomes %3F, `@` becomes %40, `#` becomes %23.
# An un-encoded password parses as part of the host and fails with an opaque
# auth error rather than anything that names the real problem.

# Runtime value, pushed to Vercel. The pooler params matter: a serverless
# function opens a connection per invocation and exhausts the pool without them.
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"

# The same pooler URL WITHOUT the query string. Used locally for
# `prisma migrate deploy` only and never pushed to Vercel — migrations take
# advisory locks, which do not survive being run through pgbouncer settings
# meant for short-lived runtime queries.
MIGRATE_DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth --------------------------------------------------------
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Bypasses row-level security entirely. Never give this a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Hosts ----------------------------------------------------------------
# Fill these in AFTER the first `vercel deploy`, once you know the assigned
# hostname. Both app-facing hosts are the same URL; the sites host is parked on
# the reserved .invalid TLD until you own a real domain. See DEPLOY.md.
NEXT_PUBLIC_MARKETING_HOST="YOUR-PROJECT.vercel.app"
NEXT_PUBLIC_APP_HOST="YOUR-PROJECT.vercel.app"
NEXT_PUBLIC_SITES_HOST="sites.invalid"

# --- Rate limiting (optional) ---------------------------------------------
# Leave blank to accept per-instance in-memory limiting. The app boots either
# way and warns when these are absent.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
