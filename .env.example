# Copy to .env and fill in. .env is gitignored; this template is not.

# --- Database -------------------------------------------------------------
# Supabase IS Postgres, so Prisma connects to it directly. Prisma owns the
# `public` schema; Supabase owns `auth` and `storage`.
#
# Local:      run `npx supabase start`, then use the DB URL it prints.
# Production: the Session-pooler connection string from your Supabase project.
#             Add ?pgbouncer=true&connection_limit=1 when using the pooler.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# --- Supabase Auth --------------------------------------------------------
# `supabase start` prints these locally; production values come from
# Project Settings → API. The service-role key bypasses RLS entirely — it must
# never gain a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Hosts ----------------------------------------------------------------
# Three surfaces. Published sites live on a SEPARATE registrable domain so a
# stored XSS on a customer site cannot reach app session cookies.
#
# dev:  localhost:3000 | app.localhost:3000 | {slug}.sites.localhost:3000
# prod: yourbuilder.com | app.yourbuilder.com | {slug}.yourbuilder.site
NEXT_PUBLIC_MARKETING_HOST="localhost:3000"
NEXT_PUBLIC_APP_HOST="app.localhost:3000"
NEXT_PUBLIC_SITES_HOST="sites.localhost:3000"

# --- Rate limiting (optional) ---------------------------------------------
# Without these the limiter falls back to an in-memory store, which is fine for
# a single dev process but useless across serverless instances. Set both in
# production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
